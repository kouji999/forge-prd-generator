# ─────────────────────────────────────────────
# FORGE — AI PRD Generator
# Copy this file to `.env.local` and fill in the values.
# ─────────────────────────────────────────────

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Database (PostgreSQL 17 — Supabase atau Postgres biasa) ──
# Supabase: Dashboard > Project Settings > Database > Connection string
#   DATABASE_URL  = pooled connection (port 6543, pgbouncer)
#   DIRECT_URL    = direct connection (port 5432)
# Plain Postgres: both point to the same local instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forge"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/forge"

# ── Supabase (Auth) ──
# Get from: Supabase Dashboard > Project Settings > API
# Kosongkan untuk menjalankan lokal tanpa auth (dev-mode); mengisi env ini
# mengaktifkan auth asli + route guard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers ──
# Priority: 9Router > AgentRouter > OpenRouter (first configured key wins as fallback)

# 9Router — default/recommended. Local 9Router proxy:
#   http://localhost:20128/v1 (model: Dev-Stack)
# Hosted alternative (optional): https://api.9router.com/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_MODEL=Dev-Stack

# AgentRouter — fixed model: claude-opus-4-8
# Get from: https://agentrouter.org
AGENTROUTER_API_KEY=

# OpenRouter — 1 key untuk semua model (GPT, Claude, Gemini, Kimi, DeepSeek, Qwen)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Custom engine security ──
# Encrypts user-supplied engine API keys at rest (AES-256-GCM). REQUIRED for saved AI engines.
# Generate with: openssl rand -base64 48
ENGINE_ENC_SECRET=

# ── Local AI endpoints (self-hosted, single-user) ──
# true = permit localhost/127.0.0.1 engine base URLs for custom engines
ALLOW_LOCAL_AI_ENDPOINTS=false
